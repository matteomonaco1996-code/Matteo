---
import Base from '../layouts/Base.astro';
import { marked } from 'marked';
import { leggi } from '../lib/contenuti';

const p = leggi('privacy');
const html = await marked.parse(p.testo ?? '');
---
<Base titolo={p.titolo}>
  <section class="sezione">
    <div class="contenitore contenitore--stretto prosa">
      <h1>{p.titolo}</h1>
      <Fragment set:html={html} />
    </div>
  </section>
</Base>
